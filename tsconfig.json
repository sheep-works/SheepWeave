{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "out",
        "lib": [
            "es2020",
            "DOM"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@sheep-family/types": ["modules/SheepComb/packages/types/src/index.ts"]
        }
    },
    "include": [
        "src/**/*",
        "modules/SheepComb/packages/types/src/**/*",
        "modules/SheepComb/packages/core/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules",
        ".vscode-test",
        "webview"
    ]
}